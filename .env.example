# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL via Prisma)
# Supavisor / Pooler URL (Transaction mode on port 6543, or Session mode on port 5432)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432, used for Prisma migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase API & Project Keys (Optional for client SDK / Storage / Auth)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LLM Provider (OpenRouter — routes to 300+ models via single API key)
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="google/gemini-2.5-flash"

# WhatsApp Bot Configuration
ALLOWED_GROUP_JIDS=""

# Agent Configuration
TRIGGER_KEYWORD="lc"
CONTEXT_MAX_MESSAGES=15
CONTEXT_TTL_MINUTES=30
