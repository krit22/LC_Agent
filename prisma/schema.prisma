datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Domain {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  members PersonDomain[]
  tasks   Task[]

  @@map("domains")
}

model Person {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  year      Int      @db.SmallInt // 1, 2, 3, or 4
  phoneJid  String?  @unique @map("phone_jid") @db.VarChar(100)
  role      String   @default("member") @db.VarChar(100)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  domains PersonDomain[]
  tasks   Task[]

  @@map("people")
}

model PersonDomain {
  personId  String   @map("person_id") @db.Uuid
  domainId  String   @map("domain_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([personId, domainId])
  @@map("person_domains")
}

model Task {
  id              String    @id @default(uuid()) @db.Uuid
  task            String    @db.Text
  description     String?   @db.Text
  assignedToId    String?   @map("assigned_to") @db.Uuid
  domainId        String?   @map("domain_id") @db.Uuid
  workflowType    String    @default("GENERAL") @map("workflow_type") @db.VarChar(50) // "GENERAL" | "POSTER"
  status          String    @default("ASSIGNED") @db.VarChar(50)
  feedback        String?   @db.Text // Holds details for "changes requested" or review notes
  priority        String    @default("medium") @db.VarChar(20) // "low" | "medium" | "high" | "urgent"
  dueDate         DateTime? @map("due_date") @db.Timestamptz()
  metadata        Json      @default("{}")
  sourceMessageId String?   @map("source_message_id") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  assignee Person? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  domain   Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Spreadsheet {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  url         String   @db.Text
  description String?  @db.Text
  purpose     String?  @db.VarChar(255) // e.g. "Club Membership 2026", "Event Registrations", "Budget"
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("spreadsheets")
}

model ScheduledJob {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(255)
  cronExpression String    @map("cron_expression") @db.VarChar(100) // e.g. "0 8 * * *"
  timezone       String    @default("Asia/Kolkata") @db.VarChar(50)
  targetJid      String    @map("target_jid") @db.VarChar(100)      // Target WhatsApp group or chat JID
  prompt         String    @db.Text                                // Action prompt dispatched to Agent Brain
  status         String    @default("ACTIVE") @db.VarChar(50)       // "ACTIVE" | "PAUSED"
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz()
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("scheduled_jobs")
}

model MessageAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @unique @map("message_id") @db.VarChar(255)
  senderJid      String   @map("sender_jid") @db.VarChar(100)
  groupJid       String   @map("group_jid") @db.VarChar(100)
  messageText    String?  @map("message_text") @db.Text
  intentDetected String?  @map("intent_detected") @db.VarChar(100)
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("message_audit_logs")
}
